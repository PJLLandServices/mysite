# PJL Land Services — backend secrets
#
# Copy this file to ".env" (no extension) and fill in real values.
# .env is gitignored — NEVER commit it. Render gets these via its dashboard, not this file.
#
# Until these are set, lead intake still works — emails and SMS just get logged
# to the server console and skipped, instead of being sent. Set them whenever
# you're ready to turn notifications on.

# ============================================================
# Email notifications (Gmail / Google Workspace SMTP)
# ============================================================
# The Gmail / Google Workspace account used to AUTHENTICATE outbound
# email. Can be any address on the Workspace tenant — customer-facing
# From-headers come from CUSTOMER_EMAIL below, not from this account.
# Gmail's "Send mail as" alias feature lets a patrick@ login send with
# an info@ From-header without changing the auth.
GMAIL_USER=

# A Google "App Password" — NOT your regular Gmail password.
# Create one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be turned on first.)
# It's a 16-character string with no spaces, e.g. "abcdwxyz12345678".
GMAIL_APP_PASSWORD=

# Customer-facing From: + Reply-To: address on every outbound email
# the customer sees (invoices, quotes, portal messages, booking links,
# completion notes, etc.) AND the e-Transfer / "send PDF back to" address
# rendered into invoice + quote PDFs. Defaults to info@pjllandservices.com
# when blank. KEEP this distinct from GMAIL_USER so the address the
# customer replies to is never tied to whichever Gmail account happens
# to be doing SMTP auth.
CUSTOMER_EMAIL=

# Where the "you got a new lead" email is sent. Defaults to GMAIL_USER
# if blank. Internal alerts only — not customer-visible.
NOTIFY_TO_EMAIL=

# ============================================================
# SMS notifications (Twilio)
# ============================================================
# Twilio Account SID — starts with "AC". From console.twilio.com -> Account Info.
TWILIO_ACCOUNT_SID=

# Twilio Auth Token — paired with the SID. Same place.
TWILIO_AUTH_TOKEN=

# The Twilio phone number you bought, in E.164 format (with +1 country code).
# Example: +14165550100
TWILIO_FROM_NUMBER=

# Your cell phone — where SMS alerts go. E.164 format.
# Also the destination for call-forward voicemail SMS alerts: unanswered
# calls forwarded from your Telus line hit the Twilio number's Voice
# webhook (/api/twilio-voice-incoming), which records a voicemail and texts
# a tap-to-listen link here. Same creds above — nothing extra to set. The
# transcription + audio is emailed to NOTIFY_TO_EMAIL.
NOTIFY_TO_PHONE=

# ============================================================
# Public base URL (used to build the "Open in CRM" link in emails/SMS)
# ============================================================
# In production, set to your real domain. In local dev, leave blank — the server
# will use whatever host the request came in on (usually http://127.0.0.1:4173).
PUBLIC_BASE_URL=

# ============================================================
# Cloudflare Turnstile (anti-bot gate on lead-intake forms)
# ============================================================
# Free at cloudflare.com → Turnstile → Add site. Pick widget mode "Managed"
# so the challenge is invisible for clean traffic and only surfaces a small
# checkbox for suspicious sessions. Two values come back: a public site key
# (safe in HTML) and a private secret key (server-only).
#
# Until both are set, anti-bot honeypot + time-trap + per-IP rate-limit are
# still active. Turnstile is the final layer and gracefully no-ops when the
# secret is unset (local dev, fresh deploy, key rotation). See §15.14 of
# WEBSITE_MAINTENANCE_AND_SEO_HANDOFF.md for setup steps.
#
# Public site key — exposed inline in form HTML. Used by the client widget.
TURNSTILE_SITE_KEY=

# Private secret key — server-side verification of the token Turnstile
# emits on form submit. NEVER commit, NEVER expose to the browser.
TURNSTILE_SECRET_KEY=

# ============================================================
# Anthropic Claude API (vision — irrigation zone photo extraction)
# ============================================================
# Used by /api/irrigation-extract-zones to analyze a property site plan
# and auto-detect color-coded irrigation zones for the public fillable
# tool at /irrigation-zone-schedule.html.
#
# This is the SAME key the chat Worker (worker/worker.js) uses, but it
# has to be set in Render's env separately — Cloudflare's env doesn't
# carry across. Until set, the endpoint returns 503 and the page falls
# back to manual entry with a clean "AI not configured" message.
#
# Get it from console.anthropic.com → API Keys. The endpoint is rate-
# limited to 10 calls/IP/hour as a cost circuit breaker.
ANTHROPIC_API_KEY=

# Google Maps.
#   GOOGLE_MAPS_SERVER_KEY  — server-side only: Distance Matrix (drive times),
#                             Geocoding, and Directions (the road line drawn on
#                             the season-plan day maps). Never sent to a browser.
#   GOOGLE_MAPS_BROWSER_KEY — sent to signed-in admins so the season-plan page can
#                             load the Maps JavaScript API. A browser key is
#                             visible to anyone who loads the map by design, so
#                             restrict it by HTTP referrer to this domain and
#                             limit its API list to Maps JavaScript API.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
