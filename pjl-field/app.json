{
  "expo": {
    "name": "PJL Field",
    "slug": "pjl-field",
    "owner": "pjllandservices",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4D2E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pjllandservices.field",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0e85ca2e-506f-436e-8814-0b3dd2086582"
      }
    }
  }
}
